+    /// <summary>The visual layer a track maps to: its position among launchable columns.</summary>
+    private int VisualLayer(int trackId)
+    {
+        // openVJ layer 0 is the bottom of the mix; NotA's first track is the top row, so the
+        // order is reversed. Group columns are not layers (their children are).
+        var cols = _cols.Where(c => c.Kind == ColKind.Track).ToList();
