+    /// Moves a column (and its clips) to another place, shifting the ones between.
+    pub fn move_column(&mut self, from: usize, to: usize) {
+        if from >= self.columns.len() || to >= self.columns.len() || from == to {
+            return;
+        }
+        let c = self.columns.remove(from);
+        self.columns.insert(to, c);
+        for layer in &mut self.layers {
+            if from < layer.clips.len() && to < layer.clips.len() {
+                let clip = layer.clips.remove(from);
+                layer.clips.insert(to, clip);
+            }
+        }
+    }
